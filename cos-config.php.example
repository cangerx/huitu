<?php

declare(strict_types=1);

// 腾讯云 COS (Cloud Object Storage) 配置
// 复制本文件为 cos-config.php 并填入真实配置

define('COS_REGION', 'ap-guangzhou');                       // COS 地域（如 ap-guangzhou, ap-shanghai, ap-beijing）
define('COS_SECRET_ID', '');                                // SecretId
define('COS_SECRET_KEY', '');                               // SecretKey
define('COS_BUCKET', '');                                   // Bucket 名称（含 APPID，如 mybucket-1250000000）
define('COS_PUBLIC_BASE_URL', '');                          // 公开访问域名（留空则使用签名 URL）
                                                            // 示例: https://mybucket-1250000000.cos.ap-guangzhou.myqcloud.com
                                                            // 或绑定的 CDN/自定义域名: https://cos.example.com
define('COS_KEY_PREFIX', 'cang-api-draw');                  // 对象 Key 前缀
define('COS_SIGNED_URL_EXPIRES', 3600);                     // 签名 URL 有效期（秒），默认 1 小时
